{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "Name": "TinClass",
    "Currency": "CNY"
  },
  "Database": {
    "Provider": "sqlite",
    "MigrateOnStart": true
  },
  "Jwt": {
    "Issuer": "tinaclass-api",
    "Audience": "tinaclass-app",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "SignInRequestsPerMinute": 20
  },
  "Jobs": {
    "SessionCleanupMinutes": 60,
    "ChatPurgeMinutes": 360
  },
  "Chat": {
    "PurgeAfterDays": 30
  },
  "Models": {
    "DefaultProvider": "echo",
    "DefaultModelCode": "echo-1",
    "Echo": {
      "DelayMs": 14,
      "ThinkMs": 350
    }
  },
  "Knowledge": {
    "IndexerPollMs": 600
  },
  "Agents": {
    "StepDelayMs": 700
  },
  "Workflows": {
    "NodeDelayMs": 600
  },
  "Team": {
    "InviteDays": 7,
    "InviteUrl": "tinaclass://accept-invite?token="
  },
  "Email": {
    "Mode": "Log",
    "From": "no-reply@example.com"
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "Seed": {
    "SampleData": false
  }
}
