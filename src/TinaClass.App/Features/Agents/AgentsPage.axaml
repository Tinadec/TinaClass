<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:al="using:TinaClass.App.Features.Agents.Localization"
             xmlns:a="using:TinaClass.App.Features.Agents"
             xmlns:ui="using:TinaClass.App.Common.Ui"
             x:Class="TinaClass.App.Features.Agents.AgentsPage"
             x:DataType="a:AgentsViewModel">
    <!-- The agent list is a ListBox in a panel; the run is Arc's AgentPlan (filled by code-behind from the run's steps); the approval banner is an Alert
         and its dialog is Dialog + HoldToConfirm (ApprovalReview.cs). Hand-rolled here: the read-only DescriptionList and the StatusDot of a server. -->
    <Grid x:Name="Columns" ColumnDefinitions="288,*" Margin="24,20,24,24" ColumnSpacing="16">
        <Border Classes="panel" VerticalAlignment="Stretch">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="section secondary" Margin="16,14,16,8" Text="{al:AgentsLangResource ListTitle}" />
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent" Padding="6,0,6,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="a:AgentRow">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,6" ColumnSpacing="10">
                                <lucide:LucideIcon Kind="{Binding Icon}" Size="16" VerticalAlignment="Top" Margin="0,3,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                    <TextBlock Classes="muted small" Text="{Binding Meta}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <arc:Badge Grid.Column="2" VerticalAlignment="Top" IsVisible="{Binding HasLive}" Tone="{Binding LiveTone}" Content="{Binding LiveText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="0,0,4,0">
                <arc:Alert Tone="Danger" IsOpen="{Binding HasError}" Content="{Binding Error}" />
                <Border Classes="panel" Padding="16,10" IsVisible="{Binding HasPending}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <ui:StatusDot Tone="Warning" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding PendingText}" />
                        <arc:Button Grid.Column="2" Classes="compact" Variant="Secondary" Command="{Binding ReviewCommand}" Content="{al:AgentsLangResource Review}" />
                    </Grid>
                </Border>
                <StackPanel IsVisible="{Binding HasNoAgents}" Spacing="4" Margin="0,80,0,0" HorizontalAlignment="Center">
                    <TextBlock Classes="h2" HorizontalAlignment="Center" Text="{al:AgentsLangResource Empty}" />
                    <TextBlock Classes="muted" HorizontalAlignment="Center" Text="{al:AgentsLangResource EmptyHint}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding HasAgent}" Spacing="16">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="display" Text="{Binding SelectedName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding SelectedDescription}" />
                    </StackPanel>
                    <Border Classes="panel" Padding="16,12">
                        <ui:DescriptionList ItemsSource="{Binding Facts}" LabelWidth="88" />
                    </Border>

                    <Border Classes="panel" Padding="16,12">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section secondary" Text="{al:AgentsLangResource ToolsTitle}" />
                                <TextBlock Grid.Column="1" Classes="muted small" Text="{al:AgentsLangResource ToolsNote}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Tools}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="0" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="a:ToolRow">
                                        <Border Classes="line" Padding="0,7">
                                            <Grid ColumnDefinitions="*,Auto,120" ColumnSpacing="12">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <arc:Badge Grid.Column="1" Tone="{Binding RiskTone}" Content="{Binding Risk}" />
                                                <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding Approval}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel" Padding="16,12">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="section secondary" Text="{al:AgentsLangResource LatestRun}" />
                                <arc:Badge Grid.Column="1" IsVisible="{Binding HasRun}" Tone="{Binding RunTone}" Content="{Binding RunState}" />
                            </Grid>
                            <TextBlock IsVisible="{Binding HasRun}" Text="{Binding RunSubject}" TextWrapping="Wrap" FontWeight="Medium" />
                            <TextBlock IsVisible="{Binding HasRun}" Classes="muted small mono" Text="{Binding RunMeta}" />
                            <arc:AgentPlan x:Name="Plan" IsVisible="{Binding HasRun}" />
                            <StackPanel IsVisible="{Binding HasNoRun}" Spacing="2" Margin="0,8">
                                <TextBlock FontWeight="Medium" Text="{al:AgentsLangResource NoRun}" />
                                <TextBlock Classes="muted" Text="{al:AgentsLangResource NoRunHint}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel" Padding="16,12" IsVisible="{Binding HasPastRuns}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section secondary" Text="{al:AgentsLangResource RecentRuns}" />
                            <ItemsControl ItemsSource="{Binding PastRuns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="a:PastRunRow">
                                        <Border Classes="line" Padding="0,7">
                                            <Grid ColumnDefinitions="*,Auto,60,60" ColumnSpacing="12">
                                                <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <arc:Badge Grid.Column="1" Tone="{Binding Tone}" Content="{Binding State}" />
                                                <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding When}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Classes="muted small mono" Text="{Binding Cost}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel" Padding="16,12">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section secondary" Text="{al:AgentsLangResource Servers}" />
                            <ItemsControl ItemsSource="{Binding Servers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="a:ServerRow">
                                        <Border Classes="line" Padding="0,7">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                <ui:StatusDot Tone="{Binding Tone}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="muted small mono" Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding Tools}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Classes="muted small" Text="{Binding Status}" MinWidth="64" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
