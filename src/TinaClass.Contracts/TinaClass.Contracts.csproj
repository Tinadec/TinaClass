<Project Sdk="Microsoft.NET.Sdk">
  <!-- The API's request and response types, shared by the API and the desktop app. No dependencies, no reflection:
       ContractsJsonContext serializes them with source-generated code, so the app can be trimmed and AOT-compiled.
       They stay in the package even when the API is left out: the app's own services may use them. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
