# Copy to deploy/.env and fill in. deploy/.env is ignored by git: never commit it.

# Signs the access tokens: 32 or more random characters, e.g.  openssl rand -base64 48
JWT_SIGNING_KEY=

# The first administrator, created on the first start when there are no accounts (10 or more characters). Remove both afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email: Log writes who and what (never the text) to the container log; Smtp sends them.
EMAIL_MODE=Log
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
